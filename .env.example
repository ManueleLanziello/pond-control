# Credenziali condivise dai client TPAP/SPAKE2+ e KLAP v2.
TAPO_USERNAME=your_email_here
TAPO_PASSWORD=your_password_here

# Impostazioni opzionali usate dagli strumenti diagnostici.
TAPO_DEVICE_IPS=your_device_ips_here
TAPO_DISCOVERY_TIMEOUT_MS=5000
TAPO_DEVICE_TIMEOUT_MS=5000

# Telecamera Pond C410 (nessun hostname o IP e' hardcodato nel codice).
TAPO_CAMERA_IP=

# Coordinate Pond per la temperatura ambiente Open-Meteo.
POND_LATITUDE=
POND_LONGITUDE=
# Progetto Tuya operativo Home Control 24/7, usato dal Dewin.
TUYA_CLIENT_ID_HOME=
TUYA_CLIENT_SECRET_HOME=
TUYA_DEWIN_ID=
# Progetto Tuya Pond Control 24/7: riferimento legacy, non usato dal runtime Dewin.
TUYA_CLIENT_ID_POND=
TUYA_CLIENT_SECRET_POND=
# Opzionale: percorso Python alternativo. Di default usa .venv-camera.
# TAPO_CAMERA_PYTHON=C:\\percorso\\python.exe
