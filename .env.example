# Credenziali dell'account TP-Link/Tapo associato alla P105.
# Il traffico di lettura resta locale; le credenziali servono al protocollo locale cifrato.
TAPO_USERNAME=nome@example.com
TAPO_PASSWORD=InserireLaPasswordSoloNelFileEnvLocale

# Fallback opzionale se il broadcast UDP non attraversa correttamente un'interfaccia Windows.
# Accetta uno o piu IPv4 separati da virgola.
TAPO_DEVICE_IPS=192.168.1.123

# Timeout opzionali in millisecondi.
TAPO_DISCOVERY_TIMEOUT_MS=5000
TAPO_DEVICE_TIMEOUT_MS=5000
